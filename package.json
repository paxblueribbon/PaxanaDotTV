{
  "name": "paxana-dot-tv",
  "version": "1.0.0",
  "description": "Single-channel shared video streaming site",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n server,client -c cyan,magenta \"node server.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "update": "git pull origin claude/shared-video-streaming-qpbZ9 && npm run build --prefix client"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "megajs": "^1.1.0",
    "multer": "^1.4.5-lts.1",
    "node-media-server": "^2.6.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
